  },
  "md": {
   "$value": "12px",
   "$description": "Cards and panels"
  },
  "pill": {
   "$value": "999px",
   "$description": "Pills, tags, switches"
  }
 },
 "shadow": {
  "$type": "shadow",
  "1": {
   "$value": "0 1px 2px rgb(13 18 24 / 6%), 0 1px 1px rgb(13 18 24 / 4%)"
  },
  "2": {
   "$value": "0 6px 20px rgb(13 18 24 / 10%), 0 2px 6px rgb(13 18 24 / 6%)"
  }
 },
 "motion": {
  "fast": {
   "$type": "duration",
   "$value": "120ms"
  },
  "base": {
   "$type": "duration",
   "$value": "220ms"
  },
  "ease": {
   "$type": "cubicBezier",
   "$value": [
    0.2,
    0.7,
    0.2,
    1
   ]
  }
 },
 "breakpoint": {
  "$type": "dimension",
  "$description": "Two breakpoints only. Media queries use max-width 640px (phones) and max-width 1023px (tablets and small laptops).",
  "phone": {
   "$value": "640px"
  },
  "tablet": {
   "$value": "1023px"
  }
 },
 "target": {
  "$type": "dimension",
  "min": {
   "$value": "44px",
   "$description": "Smallest touch target (WCAG 2.5.5 enhanced; 2.5.8 needs 24px)"
  }
 },
 "layout": {
  "$type": "dimension",
  "drawer": {
   "$value": "272px",
   "$description": "Width of the retractable page menu"
  },
  "measure": {
   "$value": "72ch",
   "$description": "Longest comfortable line of text"
  },
  "max": {
   "$value": "1440px",
   "$description": "Widest the page frame grows"
  }
 }
