 "font": {
  "$type": "fontFamily",
  "body": {
   "$value": [
    "Atkinson Hyperlegible Next",
    "Segoe UI",
    "system-ui",
    "sans-serif"
   ],
   "$description": "Designed by the Braille Institute for legibility; OFL 1.1; self-hosted"
  },
  "display": {
   "$value": [
    "Atkinson Hyperlegible Next",
    "Segoe UI",
    "system-ui",
    "sans-serif"
   ]
  },
  "mono": {
   "$value": [
    "IBM Plex Mono",
    "ui-monospace",
    "Menlo",
    "monospace"
   ],
   "$description": "Codes and identifiers; OFL 1.1; self-hosted"
  }
 },
 "size": {
  "$type": "dimension",
  "$description": "Seven type sizes. The two largest grow with the screen.",
  "xs": {
   "$value": "0.8125rem"
  },
  "sm": {
   "$value": "0.875rem"
  },
  "base": {
   "$value": "1rem"
  },
  "md": {
   "$value": "1.125rem"
  },
  "lg": {
   "$value": "1.375rem"
  },
  "xl": {
   "$value": "clamp(1.5rem, 1.1rem + 1.4vw, 2rem)"
  },
  "2xl": {
   "$value": "clamp(2rem, 1.2rem + 3vw, 3rem)"
  }
 },
 "space": {
  "$type": "dimension",
  "1": {
   "$value": "4px"
  },
  "2": {
   "$value": "8px"
  },
  "3": {
   "$value": "12px"
  },
  "4": {
   "$value": "16px"
