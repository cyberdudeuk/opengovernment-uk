 "reorganisation": {
  "summary": {
   "value": "England's two-tier areas (a county council with district councils under it) are being replaced by single-tier unitary councils. There are 21 areas. Surrey's two new councils start on 1 April 2027. Five areas have 'minded to' decisions (29 October 2026). The other 15 are under review after decisions were withdrawn in September and October 2026; every area is due an outcome by early 2027.",
   "src": [
    "five-counties",
    "withdrawn-9",
    "review-6",
    "review-launch"
   ]
  },
  "postponed_2026": {
   "value": "Of 136 council elections due in May 2026, 29 were postponed to help reorganisation; 107 went ahead.",
   "src": [
    "postpone-2026"
   ]
  },
  "statuses": {
   "decided": {
    "label": "Decided",
    "plain": "The new councils are confirmed."
   },
