"decisions": {
"City of Edinburgh Council": {
"id": "ons-name:edinburgh-city-council",
"why": "The register holds the council under the ONS form 'Edinburgh City Council'; the Local Government etc. (Scotland) Act 1994, Schedule 1 names the area 'City of Edinburgh'."
},
"Comhairle nan Eilean Siar": {
"id": "ons-name:comhaire-nan-eilean-siar-council",
"why": "The register's ONS-derived record is misspelt ('Comhaire') and carries no nation tag; it is the only Eilean Siar council record."
},
"Causeway Coast and Glens Borough Council": {
"id": "ons-name:causeway-coast-and-glens-district-council",
"why": "The register keeps the council's original 'District Council' title; nidirect uses its current borough title. It is the only Causeway Coast and Glens council record."
}
}
