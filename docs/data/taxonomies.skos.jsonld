  },
  {
   "@id": "https://cyberdudeuk.github.io/opengovernment-uk/id/scheme/btype/agency",
   "@type": "skos:Concept",
   "skos:prefLabel": "Executive agency or part of a department",
   "skos:inScheme": {
    "@id": "https://cyberdudeuk.github.io/opengovernment-uk/id/scheme/btype"
   },
   "skos:definition": "Run by civil servants inside a department, with its own job to do."
  },
  {
   "@id": "https://cyberdudeuk.github.io/opengovernment-uk/id/scheme/btype/ndpb",
   "@type": "skos:Concept",
   "skos:prefLabel": "Arm's-length public body",
   "skos:inScheme": {
    "@id": "https://cyberdudeuk.github.io/opengovernment-uk/id/scheme/btype"
   },
   "skos:definition": "Set up by law or by ministers to work at arm's length: an executive or advisory non-departmental public body, or another statutory body."
  },
  {
   "@id": "https://cyberdudeuk.github.io/opengovernment-uk/id/scheme/btype/court",
