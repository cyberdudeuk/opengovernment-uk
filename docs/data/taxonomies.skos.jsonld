   "skos:inScheme": {
    "@id": "https://cyberdudeuk.github.io/opengovernment-uk/id/scheme/activity"
   },
   "skos:definition": "A parliament, assembly or council whose members debate and pass laws, approve spending and question the government."
  },
  {
   "@id": "https://cyberdudeuk.github.io/opengovernment-uk/id/scheme/activity/policy",
   "@type": "skos:Concept",
   "skos:prefLabel": "Runs a government",
